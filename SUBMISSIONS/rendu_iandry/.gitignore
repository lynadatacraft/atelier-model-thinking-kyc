# SUBMISSIONS/rendu_iandry/ : code et livrables (JSON de réponses + PDF complétés) versionnés.
# Les chemins ci-dessous sont relatifs à ce dossier.
# Les fichiers intermédiaires (audit, revue, positions, champs), les caches et les secrets ne le sont jamais.

# --- Secrets et configuration locale (le modèle .env.example reste versionné)
.env
.env.*
!.env.example

# --- Résultats produits par run_kyc.py (les livrables sont versionnés : voir les exceptions ci-dessous)
# submission/<exercice>/ : seuls les livrables (JSON de réponses et PDF complété) sont versionnés ;
# audit, revue et positions restent locaux ; run_report.json (tokens, durée, coût) est versionné.
/submission/*/*
!/submission/*/*.answers.json
!/submission/*/*.completed.pdf
# fields/ : liste des champs et positions lues dans les PDF
/fields/
# cache/ : cache local des réponses de Gemini
/cache/
ocr/
*.audit.json
*.fields.json
*.review.md
*.positions.pdf

# --- Environnements Python
venv*/
.venv/
env/

# --- Fichiers générés par Python et ses outils
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Éditeurs et système
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
