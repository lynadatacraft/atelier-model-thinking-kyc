# Copiez ce fichier en .env et renseignez la clé. Le fichier .env n'est jamais versionné.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# minimal | low | medium | high (vide = réglage par défaut du modèle)
GEMINI_THINKING_LEVEL=high
# Limite de sortie (réflexion comprise). Une limite haute ne coûte rien tant qu'elle n'est pas atteinte.
GEMINI_MAX_OUTPUT_TOKENS=65536
GEMINI_TIMEOUT_S=300
# Plafond de tokens payés pour une exécution (0 ou vide = sans limite)
GEMINI_TOKEN_BUDGET=0
# 0 désactive le cache local des réponses (cache/gemini/)
GEMINI_CACHE=1
# Résolution des pages envoyées à Gemini pour lister les champs
FIELDS_DPI=130
# Prix en dollars par million de tokens (facultatif : sert au coût estimé du rapport)
GEMINI_PRICE_IN=
GEMINI_PRICE_CACHED=
GEMINI_PRICE_OUT=
